{
  "name": "vppt-enterprise",
  "version": "1.0.0",
  "description": "Vendor & Procurement Performance Tracker — Fullstack Enterprise Command Center",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "postinstall": "npm install --prefix frontend",
    "build": "npm run build --prefix frontend",
    "migrate": "node src/scripts/migrate.js",
    "seed": "node src/scripts/seed.js",
    "db:setup": "node src/scripts/migrate.js && node src/scripts/seed.js",
    "test": "jest --runInBand --forceExit"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.10.1",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "./tests/helpers/setup.js",
    "globalTeardown": "./tests/helpers/teardown.js",
    "testMatch": ["**/tests/**/*.test.js"],
    "forceExit": true,
    "testTimeout": 30000,
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/modules/**/*.js",
      "src/middleware/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 60,
        "functions": 60
      }
    }
  }
}