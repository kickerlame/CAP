# ============================================================
# VPPT — Environment Configuration Template
# For local dev: copy this file to .env
# For Railway: Railway automatically injects MYSQL* variables!
# ============================================================

# ----- Server Configuration -----
NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1

# ----- Database (MySQL 8.0+) -----
# NOTE: On Railway, if you add a MySQL service, Railway automatically
# provides MYSQLHOST, MYSQLPORT, MYSQLDATABASE, MYSQLUSER, MYSQLPASSWORD,
# and MYSQL_URL. You DO NOT need to fill these manually on Railway!
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vppt
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
DB_TIMEZONE=+08:00

# Optional full connection URL (e.g. from cloud database providers)
# DATABASE_URL=mysql://root:password@host:3306/vppt

# ----- JWT Authentication Secrets -----
# IMPORTANT: Generate strong random secrets for production!
JWT_SECRET=change_this_to_a_long_random_secret_in_production_123456789
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change_this_to_another_long_random_refresh_secret_987654321
JWT_REFRESH_EXPIRES_IN=7d

# ----- CORS -----
# Comma-separated list of allowed origins (or * for all)
# When hosted on Railway, Express automatically allows the Railway domain.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ----- Rate Limiting -----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# ----- Logging -----
LOG_LEVEL=info
LOG_FILE=logs/app.log